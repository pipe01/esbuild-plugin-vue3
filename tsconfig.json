{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2018",
    "moduleResolution": "node",
    "sourceMap": true,
    "strict": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "lib": ["es2018"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/*.ts"]
}